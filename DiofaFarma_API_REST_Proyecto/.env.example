# =============================================================
# Variables de Entorno – DioFaFarma REST API (PLANTILLA)
# =============================================================
# Copia este archivo a .env y rellena los valores reales.
# Nunca subas el .env real a Git.

# Puerto del servidor Node.js
PORT=3000

# Configuración de la base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=diofafarma

# Secreto para JWT (cuando se implemente)
JWT_SECRET=cambia_este_secreto_en_produccion
